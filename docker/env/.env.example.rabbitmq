# RabbitMQ Configuration Example
RABBITMQ_DEFAULT_USER=minirag_user
RABBITMQ_DEFAULT_PASS=minirag_rabbitmq_2222
RABBITMQ_DEFAULT_VHOST=minirag_vhost

# Management Plugin
# Enables the web dashboard at port 15672
RABBITMQ_MANAGEMENT_ENABLED=true

# Security
# Use RabbitMQ's built-in authentication
# Not LDAP or external auth
RABBITMQ_AUTH_BACKENDS=rabbit_auth_backend_internal

# Performance
RABBITMQ_DISK_FREE_LIMIT=2000000000 #2GB